# Frontend Vite Environment Variables

# API/Backend Configuration
# Set the URL where your backend is running
# In development (local): http://localhost:5000
# In production (Railway): https://your-railway-backend.up.railway.app

# Primary API base URL (preferred)
VITE_API_BASE_URL=http://localhost:5000

# Alternative API base URLs (fallback order)
# Used if VITE_API_BASE_URL is not set
VITE_BACKEND_URL=http://localhost:5000
VITE_SERVER_URL=http://localhost:5000

# Socket.io URL
# Set this to the same as your backend URL for real-time messaging
VITE_SOCKET_URL=http://localhost:5000

# Production Example:
# VITE_API_BASE_URL=https://your-railway-backend.up.railway.app
# VITE_SOCKET_URL=https://your-railway-backend.up.railway.app
